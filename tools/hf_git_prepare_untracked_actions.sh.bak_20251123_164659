#!/usr/bin/env bash
# HyperFFactory – Prepare Actions for Git Untracked Files
# - يولّد سكربت git add لملفات CORE_FACTORY فقط.
# - يولّد قائمة اقتراحات .gitignore للفئات الثقيلة/الخارجية.
# - يسجّل UNKNOWN للمراجعة اليدوية.
#
# استخدام:
#   tools/hf_git_prepare_untracked_actions.sh

set -euo pipefail

ROOT="/root/HyperFFactory"
cd "$ROOT"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "❌ هذا المسار ليس مستودع Git: $ROOT"
  exit 1
fi

TS="$(date +%Y%m%d_%H%M%S)"
REPORT_DIR="reports"
mkdir -p "$REPORT_DIR"

ADD_SCRIPT="${REPORT_DIR}/hf_git_add_core_factory_${TS}.sh"
IGNORE_FILE="${REPORT_DIR}/hf_git_gitignore_suggestions_${TS}.txt"
MANUAL_FILE="${REPORT_DIR}/hf_git_manual_review_${TS}.txt"
SUMMARY_FILE="${REPORT_DIR}/hf_git_untracked_actions_summary_${TS}.log"

# دوال مساعدة
is_prefix() {
  # is_prefix path prefix
  case "$1" in
    "$2"*) return 0 ;;
    *)     return 1 ;;
  esac
}

classify_path() {
  local path="$1"

  # LOCAL_ENV – بيئة محلية
  if [[ "$path" == ".env" ]] || \
     [[ "$path" == ".hyperconfig" ]] || \
     [[ "$path" == ".venv" ]] || \
     is_prefix "$path" ".venv/"; then
    echo "LOCAL_ENV"
    return
  fi

  # IMPORTED_SNAPSHOT – imported / snapshots / docker / deep audits / secure
  if is_prefix "$path" "imported/opt/report/" || \
     is_prefix "$path" "imported/opt/COMPLETE_CODE_BACKUP" || \
     is_prefix "$path" "imported/opt/deepseek" || \
     is_prefix "$path" "imported/opt/sf_deep_audit_" || \
     is_prefix "$path" "imported/opt/secure" || \
     is_prefix "$path" "imported/opt/sf-venv" || \
     is_prefix "$path" "motd_backup_" || \
     is_prefix "$path" "backup/" || \
     is_prefix "$path" "archive/" || \
     [[ "$path" == *_backup_* ]] || \
     [[ "$path" == _root_conflicts_* ]]; then
    echo "IMPORTED_SNAPSHOT"
    return
  fi

  # EXTERNAL_SUITE – smartfriend / smartfrind / ffactory
  if is_prefix "$path" "imported/opt/smartfriend-suite/" || \
     is_prefix "$path" "imported/opt/smartfrind/" || \
     is_prefix "$path" "imported/opt/ffactory/" || \
     is_prefix "$path" "opt/smartfriend-suite/" || \
     is_prefix "$path" "opt/smartfrind/" || \
     is_prefix "$path" "opt/ffactory/"; then
    echo "EXTERNAL_SUITE"
    return
  fi

  # CORE_FACTORY – قلب HyperFFactory
  if is_prefix "$path" "db/" || \
     is_prefix "$path" "tools/" || \
     is_prefix "$path" "bin/" || \
     is_prefix "$path" "scripts/" || \
     is_prefix "$path" "plans/" || \
     [[ "$path" == "plan_status.md" ]] || \
     [[ "$path" == "PLAN_STATUS.md" ]] || \
     is_prefix "$path" "config/" || \
     is_prefix "$path" "data_lakehouse/" || \
     is_prefix "$path" "factories/" || \
     is_prefix "$path" "agents/" || \
     is_prefix "$path" "workers/" || \
     is_prefix "$path" "reports/" || \
     is_prefix "$path" "ai/" || \
     is_prefix "$path" "apps/" || \
     is_prefix "$path" "learning/" || \
     is_prefix "$path" "ops/" || \
     is_prefix "$path" "sql/" || \
     [[ "$path" == "ops.py" ]] || \
     [[ "$path" == "apps.py" ]] || \
     [[ "$path" == "self_learning_brain.py" ]] || \
     [[ "$path" == "simple_brain.py" ]] || \
     [[ "$path" == "awareness_system.py" ]] || \
     [[ "$path" == "live_brain_monitor.sh" ]] || \
     [[ "$path" == "structure.txt" ]]; then
    echo "CORE_FACTORY"
    return
  fi

  # UNKNOWN
  echo "UNKNOWN"
}

# تهيئة ملفات الإخراج
cat > "$ADD_SCRIPT" <<'ADDHDR'
#!/usr/bin/env bash
# Generated by tools/hf_git_prepare_untracked_actions.sh
# يضيف ملفات HyperFFactory (CORE_FACTORY) فقط إلى Git.
set -euo pipefail
ADDHDR

echo "# HyperFFactory – Gitignore suggestions (${TS})" > "$IGNORE_FILE"
echo "# هذه ليست .gitignore فعلية؛ مجرد اقتراحات manual" >> "$IGNORE_FILE"
echo >> "$IGNORE_FILE"

echo "# HyperFFactory – Manual review (${TS})" > "$MANUAL_FILE"
echo "# مسارات UNKNOWN تحتاج قرار يدوي" >> "$MANUAL_FILE"
echo >> "$MANUAL_FILE"

CORE_COUNT=0
SNAP_COUNT=0
EXT_COUNT=0
ENV_COUNT=0
UNK_COUNT=0

# جمع الملفات غير المتتبّعة (باستخدام -z لدعم المسارات الغريبة)
UNTRACKED=()
while IFS= read -r -d '' line; do
  status="${line:0:2}"
  path="${line:3}"
  if [[ "$status" == "??" ]]; then
    UNTRACKED+=("$path")
  fi
done < <(git status --porcelain -z)

if [[ "${#UNTRACKED[@]}" -eq 0 ]]; then
  echo "لا توجد ملفات غير متتبّعة."
  exit 0
fi

for path in "${UNTRACKED[@]}"; do
  class="$(classify_path "$path")"

  case "$class" in
    CORE_FACTORY)
      echo "git add '$path'" >> "$ADD_SCRIPT"
      ((CORE_COUNT++)) || true
      ;;
    IMPORTED_SNAPSHOT)
      echo "# IMPORTED_SNAPSHOT" >> "$IGNORE_FILE"
      echo "$path" >> "$IGNORE_FILE"
      echo >> "$IGNORE_FILE"
      ((SNAP_COUNT++)) || true
      ;;
    EXTERNAL_SUITE)
      echo "# EXTERNAL_SUITE (smartfriend-suite / smartfrind / ffactory)" >> "$IGNORE_FILE"
      echo "$path" >> "$IGNORE_FILE"
      echo >> "$IGNORE_FILE"
      ((EXT_COUNT++)) || true
      ;;
    LOCAL_ENV)
      echo "# LOCAL_ENV" >> "$IGNORE_FILE"
      echo "$path" >> "$IGNORE_FILE"
      echo >> "$IGNORE_FILE"
      ((ENV_COUNT++)) || true
      ;;
    UNKNOWN)
      echo "$path" >> "$MANUAL_FILE"
      ((UNK_COUNT++)) || true
      ;;
  esac
done

chmod +x "$ADD_SCRIPT"

# ملخص
{
  echo "=================================================="
  echo "🧩 HyperFFactory – Untracked Actions Plan"
  echo "ROOT   : $ROOT"
  echo "TIME   : $(date '+%Y-%m-%d %H:%M:%S')"
  echo "ADD    : $ADD_SCRIPT"
  echo "IGNORE : $IGNORE_FILE"
  echo "MANUAL : $MANUAL_FILE"
  echo "=================================================="
  echo "CORE_FACTORY      : $CORE_COUNT   (جاهزة ل git add عبر السكربت)"
  echo "IMPORTED_SNAPSHOT : $SNAP_COUNT   (اقتراح ignore)"
  echo "EXTERNAL_SUITE    : $EXT_COUNT   (smartfriend / smartfrind / ffactory)"
  echo "LOCAL_ENV         : $ENV_COUNT   (.env / .venv / ...)"
  echo "UNKNOWN           : $UNK_COUNT   (تحتاج قرار يدوي)"
  echo "=================================================="
} | tee "$SUMMARY_FILE"

echo
echo "تم إنشاء خطة الأوامر:"
echo "  - سكربت إضافة CORE_FACTORY : $ADD_SCRIPT"
echo "  - اقتراحات gitignore       : $IGNORE_FILE"
echo "  - مراجعة يدوية UNKNOWN      : $MANUAL_FILE"
echo "  - ملخص                       : $SUMMARY_FILE"
echo
echo "لتنفيذ إضافة ملفات المصنع فقط:"
echo "  bash '$ADD_SCRIPT'"
